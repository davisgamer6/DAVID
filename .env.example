# ============================================================================
# CONFIGURACION DEL BOT DE ALERTAS DE TRADING (SOLO LECTURA)
# ============================================================================
# IMPORTANTE - MODULO DE SEGURIDAD (HUMAN-IN-THE-LOOP):
# Este sistema JAMAS debe recibir un API Secret de exchange con permisos de
# trading/retiro. Los streams de mercado de Binance usados aqui son PUBLICOS
# (no requieren autenticacion), por eso no existe ninguna variable
# BINANCE_API_KEY / BINANCE_API_SECRET en esta plantilla. Si alguna vez ves
# una de esas variables en un .env de este proyecto, elimina el proceso: no
# es soportado y `src/security/readOnlyGuard.ts` abortara el arranque.
# ============================================================================

# --- Base de datos local ---
SQLITE_DB_PATH=./data/trading-alerts.db

# --- Mercado (solo lectura, streams publicos) ---
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443
BINANCE_REST_BASE_URL=https://api.binance.com

# --- Carpeta de estrategias JSON (extraidas de transcripciones de YouTube) ---
STRATEGIES_DIR=./src/strategies/examples

# --- Canales de alerta (rellena solo los que uses) ---
ALERT_CHANNELS=console            # console,telegram,discord (separados por coma)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Resolucion de señales (background job) ---
SIGNAL_RESOLUTION_POLL_MS=30000

# --- Claude / Bucle de aprendizaje ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
FEEDBACK_LOOP_INTERVAL_HOURS=24
FEEDBACK_LOOP_MIN_SAMPLES=15

# Ruta donde el bucle de aprendizaje escribe sus recomendaciones (no toca el
# codigo fuente, solo genera/actualiza este archivo de filtros de runtime)
RUNTIME_FILTERS_PATH=./data/runtime-filters.json
# Si es "true", las recomendaciones de Claude se aplican automaticamente al
# archivo de filtros de runtime. Si es "false" (recomendado), quedan solo
# registradas en SQLite (tabla strategy_adjustments) para revision humana.
FEEDBACK_LOOP_AUTO_APPLY=false
