{
  "name": "trading-alerts-copilot",
  "version": "1.0.0",
  "description": "Bot de alertas de trading (solo lectura) con bucle de aprendizaje autonomo asistido por Claude",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/db && cp src/db/migrations.sql dist/db/migrations.sql",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "ingest:example": "tsx scripts/ingestExampleStrategy.ts",
    "resolve": "tsx scripts/runResolverOnce.ts",
    "learn": "tsx scripts/runFeedbackLoop.ts",
    "db:init": "tsx scripts/initDb.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "better-sqlite3": "^11.5.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.5",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
